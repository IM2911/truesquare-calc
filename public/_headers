# Cloudflare Pages security headers (also understood by Netlify).
# Next.js `headers()` is not available with `output: "export"`, so headers live here.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # Google AdSense, its consent message (Funding Choices) and the ads it serves load scripts,
  # frames, images and requests from many rotating Google and advertiser hosts, so those
  # directives allow https: rather than a fixed list (an allowlist breaks ads silently).
  # 'unsafe-eval' is needed by parts of the ad code. Framing of this site, plugins and
  # <base> hijacking stay blocked.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src https:; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
