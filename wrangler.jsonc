// Cloudflare Workers (static assets only) — the current home of Cloudflare Pages.
// Deploy with: npm run build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truesquare-calc",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./out",
    // Serve out/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // "/about" serves about.html; "/about/" redirects to "/about".
    "html_handling": "drop-trailing-slash"
  }
}
