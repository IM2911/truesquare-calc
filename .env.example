# Copy to .env.local for local development. Never commit real secrets.
# All NEXT_PUBLIC_* values are embedded in the public JavaScript bundle — do not put secrets in them.

# Canonical site origin (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
# Rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://truesquare-calc.truesquare-calc.workers.dev

# Public contact email shown on /contact (optional).
NEXT_PUBLIC_CONTACT_EMAIL=

# Formspree-compatible form endpoint. Defaults to the site's form (see src/lib/site.ts); set only to override.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Google AdSense publisher ID (ca-pub-…). Leave EMPTY until the account is approved
# and a certified consent management platform is configured.
NEXT_PUBLIC_ADSENSE_CLIENT=
